<?xml version="1.0" ?>
<!--
  Primary rover: a box body, 4 wheels, a solar panel and a comms mast with a dish.
  Model origin = ground under the rover centre. Front = +x.
  Drive it (Gazebo topic):  gz topic -t /rover/cmd_vel -m gz.msgs.Twist -p "linear: {x: 1.0}"
-->
<sdf version="1.9">
  <model name="primary_rover">

    <!-- ===== BODY ===== -->
    <link name="chassis">
      <pose>0 0 0.3 0 0 0</pose>                       <!-- body centre 0.3 m above ground -->
      <inertial>
        <mass>30</mass>
        <inertia><ixx>1.45</ixx><iyy>2.73</iyy><izz>3.73</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>1.0 0.7 0.3</size></box></geometry>
      </collision>
      <visual name="body">
        <geometry><box><size>1.0 0.7 0.3</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="solar_panel">                      <!-- flat dark-blue panel on top -->
        <pose>0.05 0 0.16 0 0 0</pose>
        <geometry><box><size>0.85 0.68 0.02</size></box></geometry>
        <material><ambient>0.05 0.1 0.3 1</ambient><diffuse>0.1 0.15 0.45 1</diffuse></material>
      </visual>
      <visual name="mast">                             <!-- thin pole for the radio -->
        <pose>-0.35 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.8</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <visual name="antenna">                          <!-- radio antenna ball on top -->
        <pose>-0.35 0 0.97 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>1 0.6 0 1</ambient><diffuse>1 0.6 0 1</diffuse></material>
      </visual>
    </link>

    <!-- ===== WHEELS (visual = cylinder, collision = sphere: spheres roll smoothly on bumpy terrain) ===== -->
    <link name="front_left_wheel">
      <pose>0.4 0.5 0.2 -1.5707 0 0</pose>             <!-- rotated so the cylinder axis points sideways -->
      <inertial><mass>2</mass><inertia><ixx>0.032</ixx><iyy>0.032</iyy><izz>0.032</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.4 -0.5 0.2 -1.5707 0 0</pose>
      <inertial><mass>2</mass><inertia><ixx>0.032</ixx><iyy>0.032</iyy><izz>0.032</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.4 0.5 0.2 -1.5707 0 0</pose>
      <inertial><mass>2</mass><inertia><ixx>0.032</ixx><iyy>0.032</iyy><izz>0.032</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.4 -0.5 0.2 -1.5707 0 0</pose>
      <inertial><mass>2</mass><inertia><ixx>0.032</ixx><iyy>0.032</iyy><izz>0.032</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    </link>

    <!-- ===== JOINTS: let each wheel spin around the sideways (y) axis ===== -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <!-- ===== DRIVING: turns a speed command (Twist) into wheel speeds, and publishes odometry ===== -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>1.0</wheel_separation>        <!-- distance between left and right wheels (m) -->
      <wheel_radius>0.2</wheel_radius>
      <topic>/rover/cmd_vel</topic>                   <!-- send speed commands here -->
      <odom_topic>/rover/odom</odom_topic>            <!-- rover position estimate comes out here -->
      <odom_publish_frequency>10</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
