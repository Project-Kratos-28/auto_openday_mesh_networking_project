<?xml version="1.0" ?>
<!-- The crater terrain. Shape comes from meshes/crater.obj (made by scripts/generate_crater.py). -->
<sdf version="1.9">
  <model name="mars_crater">
    <static>true</static>                        <!-- ground never moves -->
    <link name="terrain">
      <collision name="collision">               <!-- the shape physics uses (what wheels touch) -->
        <geometry>
          <mesh><uri>model://mars_crater/meshes/crater.obj</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>   <!-- dusty, grippy ground -->
        </surface>
      </collision>
      <visual name="visual">                     <!-- the shape you see -->
        <geometry>
          <mesh><uri>model://mars_crater/meshes/crater.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.55 0.27 0.15 1</ambient>    <!-- rusty Mars red -->
          <diffuse>0.72 0.38 0.22 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>  <!-- matte, not shiny -->
        </material>
      </visual>
    </link>
  </model>
</sdf>
