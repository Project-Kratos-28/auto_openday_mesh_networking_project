<?xml version="1.0" ?>
<!--
  Mars crater world.
  - Crater centre = (0,0). Crater floor z = 0. Rim top z = 33. Outside plain z = 25.
  - Primary rover at the centre of the crater floor.
  - 4 relay drones hovering around the rover, ready to deploy.
  - Base station on the plain 200 m east (+x), OUTSIDE the rim: the rim blocks the
    direct line-of-sight from the rover -> that's why we need the relay mesh.
-->
<sdf version="1.9">
  <world name="mars_world">

    <gravity>0 0 -3.71</gravity>                         <!-- Mars gravity -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>                <!-- 1 ms physics step -->
      <real_time_factor>1.0</real_time_factor>            <!-- try to run at real-time speed -->
    </physics>

    <!-- Systems = Gazebo "engines": physics, GUI clicks, sending the scene to the window -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.55 0.45 0.4 1</ambient>                  <!-- soft dusty light everywhere -->
      <background>0.85 0.66 0.5 1</background>            <!-- butterscotch Mars sky -->
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>1 0.92 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.6 0.3 -0.75</direction>               <!-- low-ish sun so the crater casts shadows -->
    </light>

    <!-- ===== TERRAIN ===== -->
    <include>
      <uri>model://mars_crater</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===== PRIMARY ROVER: centre of the crater floor (dropped from 5 cm) ===== -->
    <include>
      <name>primary_rover</name>
      <uri>model://primary_rover</uri>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

    <!-- ===== RELAY DRONES: hovering 3 m up, 6 m around the rover ===== -->
    <include>
      <name>drone_1</name>
      <uri>model://relay_drone</uri>
      <pose>6 0 3 0 0 0</pose>
    </include>
    <include>
      <name>drone_2</name>
      <uri>model://relay_drone</uri>
      <pose>0 6 3 0 0 0</pose>
    </include>
    <include>
      <name>drone_3</name>
      <uri>model://relay_drone</uri>
      <pose>-6 0 3 0 0 0</pose>
    </include>
    <include>
      <name>drone_4</name>
      <uri>model://relay_drone</uri>
      <pose>0 -6 3 0 0 0</pose>
    </include>

    <!-- ===== BASE STATION: on the plain, 200 m east, outside the crater (plain height z = 25) ===== -->
    <include>
      <name>base_station</name>
      <uri>model://base_station</uri>
      <pose>200 0 25 0 0 3.1416</pose>                     <!-- turned to face the crater -->
    </include>

  </world>
</sdf>
